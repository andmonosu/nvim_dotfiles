{
  "Spring Boot REST Controller": {
    "prefix": "scontroller",
    "body": [
      "@RestController",
      "@RequestMapping(\"/api/v1/${1:resource}\")",
      "@RequiredArgsConstructor",
      "public class ${TM_FILENAME_BASE} {",
      "\t",
      "\t$0",
      "}"
    ],
    "description": "Crea la estructura base de un controlador REST de Spring"
  },
  "Inyección de Dependencia (Constructor/Lombok)": {
    "prefix": "sinject",
    "body": ["private final ${1:ServiceClass} ${2:serviceName};"],
    "description": "Inyecta un Bean usando private final (requiere @RequiredArgsConstructor)"
  },
  "Endpoint GET rápido": {
    "prefix": "sget",
    "body": [
      "@GetMapping(\"${1}\")",
      "public ResponseEntity<${2:Object}> get${3:Method}() {",
      "\treturn ResponseEntity.ok($0);",
      "}"
    ],
    "description": "Genera un método de petición GET que devuelve un ResponseEntity"
  },
  "Endpoint POST rápido": {
    "prefix": "spost",
    "body": [
      "@PostMapping",
      "public ResponseEntity<${1:Object}> create(@RequestBody ${2:BodyClass} body) {",
      "\treturn ResponseEntity.status(HttpStatus.CREATED).body($0);",
      "}"
    ],
    "description": "Genera un método de petición POST con RequestBody"
  },
  "Logger de Slf4j rápido": {
    "prefix": "logf",
    "body": ["log.info(\"${1:Mensaje}: {}\", ${2:variable});"],
    "description": "Inserta un log informativo usando el logger de Lombok"
  },
  "Javadoc de método (void)": {
    "prefix": "sdocv",
    "body": [
      "/**",
      " * ${1:Descripción del método.}",
      " *",
      " * @param ${2:parametro} ${3:Descripción del parámetro}",
      " * @throws ${4:Exception} ${5:Descripción de la excepción}",
      " */",
      "$0"
    ],
    "description": "Genera un Javadoc para métodos void, con @param y @throws"
  },
  "Javadoc de método (con retorno)": {
    "prefix": "sdoct",
    "body": [
      "/**",
      " * ${1:Descripción del método.}",
      " *",
      " * @param ${2:parametro} ${3:Descripción del parámetro}",
      " * @return ${4:Descripción del valor de retorno}",
      " * @throws ${5:Exception} ${6:Descripción de la excepción}",
      " */",
      "$0"
    ],
    "description": "Genera un Javadoc para métodos con valor de retorno, con @param, @return y @throws"
  },
  "Javadoc de clase": {
    "prefix": "sdocclass",
    "body": [
      "/**",
      " * ${1:Descripción de la clase.}",
      " *",
      " * @author ${2:Tu Nombre}",
      " * @since $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      " */",
      "$0"
    ],
    "description": "Genera un Javadoc para una clase con @author y @since"
  },
  "Javadoc de interfaz": {
    "prefix": "sdocinterface",
    "body": [
      "/**",
      " * ${1:Descripción de la interfaz.}",
      " *",
      " * @author ${2:Tu Nombre}",
      " * @since $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      " */",
      "$0"
    ],
    "description": "Genera un Javadoc para una interfaz con @author y @since"
  },
  "Javadoc de enum": {
    "prefix": "sdocenum",
    "body": [
      "/**",
      " * ${1:Descripción del enum.}",
      " *",
      " * @author ${2:Tu Nombre}",
      " * @since $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      " */",
      "$0"
    ],
    "description": "Genera un Javadoc para un enum con @author y @since"
  }
}
